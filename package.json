{
  "name": "markforge",
  "version": "1.0.3",
  "description": "MarkForge",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build:uninstaller": "powershell -Command \"& 'C:\\Windows\\Microsoft.NET\\Framework64\\v4.0.30319\\csc.exe' /target:winexe /win32icon:resources\\icon.ico /out:'resources\\Uninstall MarkForge.exe' scripts\\build-uninstaller.cs\"",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:uninstaller && npm run build:renderer && npm run build:electron",
    "start": "electron .",
    "installer": "electron . --installer",
    "bump": "node scripts/bump-version.js",
    "release": "node scripts/bump-version.js && npm run dist",
    "dist": "node scripts/bump-version.js && npm run build && electron-builder --win nsis && node scripts/package-installer.js"
  },
  "keywords": [
    "markdown",
    "editor",
    "katex",
    "mermaid",
    "electron"
  ],
  "author": "MarkForge Team",
  "license": "MIT",
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vditor": "^3.11.3"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.7.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.markforge.app",
    "productName": "MarkForge",
    "fileAssociations": [
      {
        "ext": "md",
        "name": "Markdown Document",
        "description": "Markdown Document",
        "icon": "resources/icon.ico",
        "role": "Editor"
      },
      {
        "ext": "markdown",
        "name": "Markdown Document",
        "description": "Markdown Document",
        "icon": "resources/icon.ico",
        "role": "Editor"
      }
    ],
    "directories": {
      "output": "release"
    },
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!dist/vditor/js/**/*",
      "!dist/vditor/css/**/*",
      "!dist/vditor/ts/**/*",
      "!dist/vditor/types/**/*",
      "!node_modules/**/*"
    ],
    "extraFiles": [
      {
        "from": "resources/Uninstall MarkForge.exe",
        "to": "Uninstall MarkForge.exe"
      }
    ],
    "extraResources": [
      {
        "from": "resources/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MarkForge",
      "uninstallDisplayName": "MarkForge (墨拓笔记)",
      "deleteAppDataOnUninstall": false,
      "perMachine": false
    }
  }
}
